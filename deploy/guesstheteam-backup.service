[Unit]
Description=GuessTheTeam daily PostgreSQL backup
After=postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/guesstheteam
EnvironmentFile=/root/guesstheteam/.env
Environment=GTT_BACKUP_DIRECTORY=/var/backups/guesstheteam
ExecStart=/usr/bin/node scripts/backup-database.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/guesstheteam
