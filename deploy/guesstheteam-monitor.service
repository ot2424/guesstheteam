[Unit]
Description=GuessTheTeam availability and backup monitoring
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/guesstheteam
EnvironmentFile=/root/guesstheteam/.env
ExecStart=/usr/bin/node scripts/check-operations.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
