# Frontend (Vercel): only this variable is required; redeploy after changing it.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Backend only: never put database credentials in VITE_* variables.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://guesstheteam:CHANGE_ME@127.0.0.1:5432/guesstheteam
CORS_ORIGIN=http://localhost:5173
AUTH_SESSION_DAYS=30
AUTH_FRONTEND_URL=http://localhost:5173
# SMTP is required for delivery; without it development queues emails in PostgreSQL.
# Use port 465 with SMTP_SECURE=true, or port 587 with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GUESSTHETEAM_TEAM_SOURCE=postgres

TRANSFERMARKT_BACKUP_ENABLED=false
TRANSFERMARKT_API_BASE_URL=https://transfermarkt-api.fly.dev
TRANSFERMARKT_API_TIMEOUT_MS=3500
# Optional, for data enrichment scripts:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
