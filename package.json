{
  "name": "guesstheteam",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tabs": "node scripts/open-dev-terminals.mjs",
    "backend:dev": "tsx watch backend/src/server.ts",
    "backend:start": "tsx backend/src/server.ts",
    "start": "tsx backend/src/server.ts",
    "backend:build": "tsc --project tsconfig.backend.json",
    "data:import:transfermarkt": "tsx scripts/import-transfermarkt-seed.ts",
    "data:enrich:transfermarkt": "tsx scripts/enrich-transfermarkt-seed.ts",
    "data:sync:postgres": "tsx scripts/sync-teams-to-postgres.ts",
    "data:sync:worldcup": "tsx scripts/sync-worldcup-teams.ts",
    "data:enrich:postgres-careers": "tsx scripts/enrich-postgres-careers.ts",
    "data:build:team": "tsx scripts/build-team-season.ts",
    "data:generate:catalog": "tsx scripts/generate-team-catalog.ts",
    "data:build:catalog": "tsx scripts/build-teams-from-catalog.ts",
    "data:build:catalog:auto": "tsx scripts/build-teams-from-catalog.ts --continue-on-error --retry-attempts 1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:import:supabase": "tsx scripts/import-supabase-db.ts",
    "db:check": "node --import tsx scripts/check-db-migration.ts",
    "db:delete:accounts": "node --import tsx scripts/delete-all-accounts.ts",
    "db:reset:accounts": "node --import tsx scripts/reset-accounts.ts",
    "check:operations": "node scripts/check-operations.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "check:live": "node --import tsx scripts/check-live-api.mjs",
    "check:mobile": "node scripts/check-mobile.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^12.40.0",
    "helmet": "^8.2.0",
    "morgan": "^1.11.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
